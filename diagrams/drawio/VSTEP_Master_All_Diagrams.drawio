        <mxCell id="flow_s_out" value="2. Bảng điểm thang 10 &amp; Feedback" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;strokeColor=#16a34a;endArrow=block;dashed=1;labelBackgroundColor=#ffffff;labelBorderColor=#86efac;spacing=3;fontStyle=1;exitX=0.2;exitY=0;entryX=1;entryY=0.8;" edge="1" parent="1" source="sys_center" target="ent_student">
