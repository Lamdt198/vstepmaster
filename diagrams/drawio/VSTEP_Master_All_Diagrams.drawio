        <mxCell id="act_render" value="Hệ thống tải văn bản chia 2 cột: Bài đọc (Trái) &amp;amp; Câu hỏi (Phải)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=11;" vertex="1" parent="1">
