  <diagram id="07_Context_Diagram" name="07_Context_Diagram">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Center System -->
        <mxCell id="sys_center" value="«System Boundary»&#xa;HỆ THỐNG LUYỆN THI VSTEP MASTER&#xa;(Web Application - React &amp; TypeScript)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=3;fontColor=#1e3a8a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="210" width="360" height="150" as="geometry" />
        </mxCell>

        <!-- Entity 1: Student (Top-Left) -->
        <mxCell id="ent_student" value="«Actor»&#xa;Học viên (Student)&#xa;Luyện tập 4 kỹ năng &amp; Thi thử" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#15803d;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Entity 2: Admin (Bottom-Left) -->
        <mxCell id="ent_admin" value="«Actor»&#xa;Quản trị viên (Admin)&#xa;Quản lý đề thi, từ vựng &amp; user" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#92400e;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Entity 3: AI Engine (Top-Right) -->
        <mxCell id="ent_ai" value="«External System»&#xa;Google Gemini AI Engine&#xa;Phân tích ngôn ngữ theo Rubric CEFR" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=2;fontColor=#7e22ce;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="70" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- Entity 4: File Storage (Bottom-Right) -->
        <mxCell id="ent_file" value="«File Storage»&#xa;Tệp đề thi nguồn (.docx / .pdf)&#xa;Bóc tách câu hỏi và đáp án tự động" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=2;fontColor=#9f1239;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="410" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- Student <-> System: 2 Distinct Non-Overlapping Flows -->
        <mxCell id="flow_s_in" value="1. Nộp bài làm (TN, Viết, Nói)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;strokeColor=#16a34a;endArrow=block;labelBackgroundColor=#ffffff;labelBorderColor=#86efac;spacing=3;fontStyle=1;exitX=1;exitY=0.35;entryX=0;entryY=0.25;" edge="1" parent="1" source="ent_student" target="sys_center">
