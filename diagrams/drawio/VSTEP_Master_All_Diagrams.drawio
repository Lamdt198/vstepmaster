        <mxCell id="act_select" value="Học viên chọn bộ đề Reading (4 Passages - 40 câu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontStyle=1;fontSize=12;" vertex="1" parent="1">
