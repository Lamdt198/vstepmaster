@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 8

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #1D4ED8
    BorderThickness 1.5
    FontSize 12
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.5
    ArrowColor #334155
    FontSize 11
}

skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.5
    FontStyle bold
    FontSize 13
    FontColor #0F172A
}

skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #CA8A04
    FontSize 10
}

left to right direction

actor "Học viên\n(Student)" as Student #EFF6FF

rectangle "HỆ THỐNG LUYỆN THI VSTEP MASTER" {
    usecase "UC-01: Đăng nhập & Xác thực" as UC01
    usecase "UC-02: Luyện tập Listening" as UC02
    usecase "UC-03: Luyện tập Reading" as UC03
    usecase "UC-04: Luyện tập Writing" as UC04 #F5F3FF
    usecase "UC-05: Luyện tập Speaking" as UC05
    usecase "UC-06: Thi thử Mock Test 180p" as UC06 #FEF2F2
    usecase "UC-07: Bóc tách đề Word / PDF" as UC07
    usecase "UC-08: Flashcards & Từ vựng" as UC08

    usecase "UC-09: Quản lý Tài khoản & Lịch sử" as UC_AdminUser #FEF3C7
    usecase "UC-10: Quản lý Ngân hàng Đề thi" as UC_AdminExam #FEF3C7
    usecase "Tra cứu từ điển nhanh CEFR" as UC_Dict #F0FDF4
    usecase "AI Chấm điểm Tự luận\n(CEFR Rubric)" as UC_AIScoring #EDE9FE
}

actor "Quản trị viên\n(Admin)" as Admin #FEF3C7
actor "Phân hệ AI Engine\n(Google Gemini)" as AI #F5F3FF

' Order left column strictly from top to bottom
UC01 -[hidden]right- UC02
UC02 -[hidden]right- UC03
UC03 -[hidden]right- UC04
UC04 -[hidden]right- UC05
UC05 -[hidden]right- UC06
UC06 -[hidden]right- UC07
UC07 -[hidden]right- UC08

' Order right column strictly from top to bottom
UC_AdminUser -[hidden]right- UC_AdminExam
UC_AdminExam -[hidden]right- UC_Dict
UC_Dict -[hidden]right- UC_AIScoring

' Left to Right alignment hints
UC01 -[hidden]- UC_AdminUser
UC03 -[hidden]- UC_Dict
UC04 -[hidden]- UC_AIScoring

' Student connections
Student --> UC01
Student --> UC02
Student --> UC03
Student --> UC04
Student --> UC05
Student --> UC06
Student --> UC07
Student --> UC08

' Advanced relationships
UC03 <.. UC_Dict : <<extend>>
UC04 ..> UC_AIScoring : <<include>>
UC06 ..> UC_AIScoring : <<include>>

' AI Engine connection
UC_AIScoring -- AI

' Admin connections
UC_AdminExam <-- Admin
UC_AdminUser <-- Admin

note right of UC_AIScoring
  Phân tích 4 tiêu chí CEFR:
  - Task Fulfillment
  - Cohesion & Coherence
  - Lexical Resource
  - Grammatical Accuracy
end note

@enduml