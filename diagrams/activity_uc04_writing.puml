@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 8

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.5
    ArrowColor #1E293B
    FontSize 12
}

skinparam partition {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.2
    FontSize 12
    FontStyle bold
    FontColor #0F172A
}

skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #CA8A04
    FontSize 10
}

title Activity Diagram - Luyện Viết (Writing) & AI Chấm
start
partition "Chọn bài thi" {
    :Chọn bộ đề Writing;
    if (Chọn Task) then (Task 1)
        :Nạp đề bài Thư/Email;
        note left: Yêu cầu: 150-180 từ
    else (Task 2)
        :Nạp đề bài Bài luận quan điểm;
        note right: Yêu cầu: 250+ từ
    endif
}

partition "Làm bài thi" {
    :Soạn thảo bài viết trong Editor;
    :Hệ thống kiểm tra số lượng từ (word count);
    :Hoàn thành và bấm nộp bài;
}

partition "Chấm bài bằng AI" {
    :Bấm "AI Chấm điểm";
    :Gửi nội dung sang Gemini API;
    note right: Đánh giá theo 4 tiêu chí CEFR
    :Nhận kết quả phân tích từ AI;
    fork
        :Phân tích Task Fulfillment;
    fork again
        :Phân tích Organization;
    fork again
        :Phân tích Lexical Resource;
    fork again
        :Phân tích Grammatical Range & Accuracy;
    end merge
}

partition "Hiển thị Kết quả" {
    :Hiển thị Điểm số tổng quát;
    :Hiển thị các lỗi gạch chân trong bài;
    :Cung cấp gợi ý sửa lỗi;
    :Đề xuất bài mẫu nâng cao (Model Essay);
    :Lưu kết quả vào Cơ sở dữ liệu;
}
stop
@enduml
