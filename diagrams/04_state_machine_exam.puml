@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 8

skinparam state {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.5
    ArrowColor #1E293B
    FontSize 12
}

skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #CA8A04
    FontSize 10
}

[*] --> NOT_STARTED : Khởi tạo phiên làm bài

NOT_STARTED --> IN_PROGRESS : Thí sinh bấm "Bắt đầu làm bài"

state IN_PROGRESS {
    state "LISTENING (Phần thi Nghe)" as LISTENING #EFF6FF
    state "READING (Phần thi Đọc)" as READING #EFF6FF
    state "WRITING (Phần thi Viết)" as WRITING #F5F3FF
    state "SPEAKING (Phần thi Nói)" as SPEAKING #EFF6FF

    [*] --> LISTENING
    LISTENING --> READING : Hoàn thành / Chuyển phần
    READING --> WRITING : Hoàn thành / Chuyển phần
    WRITING --> SPEAKING : Hoàn thành / Chuyển phần

    note right of WRITING
      Tự động đồng bộ câu trả lời
      vào LocalStorage mỗi 5 giây
    end note
}

IN_PROGRESS --> SUBMITTED : [Thí sinh bấm Nộp bài] HOẶC [Hết giờ 180:00 (Tự động nộp)]

state SUBMITTED {
    state "OBJECTIVE_SCORED (Đã chấm trắc nghiệm)" as OBJECTIVE_SCORED #F0FDF4
    state "AI_EVALUATING (Đang chấm tự luận)" as AI_EVALUATING #EDE9FE
    state "EVALUATION_COMPLETED (Hoàn tất đánh giá)" as EVALUATION_COMPLETED #F0FDF4

    [*] --> OBJECTIVE_SCORED : So khớp Answer Key (<50ms)
    OBJECTIVE_SCORED --> AI_EVALUATING : Gửi bài luận sang Gemini API
    AI_EVALUATING --> EVALUATION_COMPLETED : Nhận kết quả & sửa lỗi chi tiết (2-4s)
}

SUBMITTED --> ARCHIVED : Tổng hợp điểm 4 kỹ năng & Xếp bậc VSTEP (B1/B2/C1)

state "ARCHIVED (Đã lưu trữ kết quả)" as ARCHIVED #FEF3C7
ARCHIVED --> [*] : Lưu vĩnh viễn vào CSDL & Cấp bảng điểm
@enduml