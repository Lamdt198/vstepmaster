@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 8

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.5
    ArrowColor #1E293B
    FontSize 12
}

skinparam partition {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.2
    FontSize 12
    FontStyle bold
    FontColor #0F172A
}

skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #CA8A04
    FontSize 10
}

title Activity Diagram - Luyện Nói (Speaking)
start
partition "Chuẩn bị" {
    :Người dùng chọn Part luyện tập;
    note right: Part 1: Phỏng vấn\nPart 2: Trình bày chủ đề\nPart 3: Thảo luận
    :Hệ thống hiển thị đề bài;
    :Cung cấp dàn ý gợi ý (Outline);
    :Bắt đầu đếm ngược thời gian chuẩn bị (1-2 phút);
}

partition "Ghi âm" {
    :Hết giờ chuẩn bị;
    :Bấm nút ghi âm;
    note right: Sử dụng MediaRecorder API
    :Nói trong thời gian quy định;
    :Dừng ghi âm khi hoàn tất hoặc hết giờ;
    :Hệ thống lưu trữ file audio;
}

partition "Đánh giá" {
    :Nghe lại bài nói vừa ghi âm;
    if (Lựa chọn hình thức đánh giá) then (Gửi AI đánh giá)
        :Gửi audio/text sang AI;
        :AI phân tích các tiêu chí;
        note right: Pronunciation, Fluency,\nVocabulary, Grammar
        :Hệ thống nhận điểm và feedback;
        :Hiển thị điểm số và nhận xét chi tiết;
    else (Tự đánh giá)
        :Tham khảo bài nói mẫu (Sample audio);
        :So sánh và tự rút kinh nghiệm;
    endif
}
stop
@enduml
