@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 8

skinparam package {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
}
skinparam component {
    BackgroundColor #F0FDF4
    BorderColor #166534
}
skinparam interface {
    BackgroundColor #F5F3FF
    BorderColor #5B21B6
}
skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #CA8A04
}

title Sơ đồ thành phần (Component Diagram) - Clean Architecture

package "Presentation Layer" {
    component "ExamView" as ExamView
    component "WritingEditor" as WritingEditor
    component "MockTestTimer" as MockTestTimer
    component "FlashcardViewer" as FlashcardViewer
    component "AuthForm" as AuthForm
}

package "Application/Service Layer" {
    component "ExamService" as ExamService
    component "AIScoringService" as AIScoringService
    component "DocumentParserService" as DocumentParserService
    component "AuthService" as AuthService
    component "VocabularyService" as VocabularyService
}

package "Domain Layer" {
    component "Exam Entity" as ExamEntity
    component "Question Entity" as QuestionEntity
    component "Submission Entity" as SubmissionEntity
    component "Score Entity" as ScoreEntity
    component "User Entity" as UserEntity
    component "Vocabulary Entity" as VocabularyEntity
}

package "Infrastructure/Adapter Layer" {
    component "AIAdapter\n(Gemini)" as AIAdapter
    component "StorageAdapter\n(LocalStorage/DB)" as StorageAdapter
    component "DocumentParserAdapter\n(Mammoth/PDF.js)" as DocumentParserAdapter
}

' Ports / Interfaces
interface "IAIScoringPort" as IAIScoringPort
interface "IStoragePort" as IStoragePort
interface "IDocumentParserPort" as IDocumentParserPort

' Presentation to Application
ExamView --> ExamService
WritingEditor --> AIScoringService
MockTestTimer --> ExamService
FlashcardViewer --> VocabularyService
AuthForm --> AuthService

' Application to Domain
ExamService --> ExamEntity
ExamService --> QuestionEntity
ExamService --> SubmissionEntity
AIScoringService --> ScoreEntity
VocabularyService --> VocabularyEntity
AuthService --> UserEntity

' Application to Interfaces (Dependency Inversion)
AIScoringService ..> IAIScoringPort : use
ExamService ..> IStoragePort : use
DocumentParserService ..> IDocumentParserPort : use
DocumentParserService ..> IStoragePort : use

' Infrastructure implements Interfaces
AIAdapter ..|> IAIScoringPort : implements
StorageAdapter ..|> IStoragePort : implements
DocumentParserAdapter ..|> IDocumentParserPort : implements

note right of "Infrastructure/Adapter Layer"
  Chứa các kết nối ra bên ngoài,
  triển khai cụ thể của các Port
end note

@enduml
