@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 8

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.5
    ArrowColor #1E293B
    FontSize 12
}

skinparam partition {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.2
    FontSize 12
    FontStyle bold
    FontColor #0F172A
}

skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #CA8A04
    FontSize 10
}

start
:Thí sinh chọn đề thi và bấm "Bắt đầu làm bài";
:Hệ thống nạp cấu trúc đề & Kích hoạt đếm ngược 180:00;

fork
    :Học viên làm bài 4 kỹ năng (Nghe, Đọc, Viết, Nói);
    :Tự động lưu tạm dữ liệu làm bài vào LocalStorage;
fork again
    repeat
        :Đồng hồ đếm ngược chạy từng giây;
    backward:Còn thời gian;
    repeat while (Hết 180 phút hoặc Bấm Nộp bài?) is (Chưa) not (Đã nộp / Hết giờ)
end fork

:Khóa toàn bộ bài thi & Kích hoạt xử lý nộp bài;

fork
    partition "Phân nhánh 1: Chấm trắc nghiệm tự động" {
        :So khớp đáp án Listening & Reading với Answer Key;
        :Tính số câu đúng và quy đổi thang 10;
        note right: Xử lý tức thì (<50ms)
    }
fork again
    partition "Phân nhánh 2: Chấm tự luận AI Engine" {
        :Gửi bài Writing / Speaking sang Gemini API;
        :AI phân tích ngữ pháp, từ vựng theo CEFR Rubric;
        :Nhận điểm số thang 10 & Bản sửa lỗi chi tiết;
    }
end fork

:Tổng hợp điểm trung bình 4 kỹ năng (Scale 10);
:Quy đổi xếp bậc năng lực VSTEP: B1 / B2 / C1;
:Hiển thị Bảng điểm điện tử & Lưu vết CSDL vĩnh viễn;
stop
@enduml