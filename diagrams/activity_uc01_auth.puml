@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 8

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.5
    ArrowColor #1E293B
    FontSize 12
}

skinparam partition {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.2
    FontSize 12
    FontStyle bold
    FontColor #0F172A
}

skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #CA8A04
    FontSize 10
}

title Activity Diagram - Đăng nhập / Đăng ký
start
:Người dùng truy cập hệ thống;
if (Chọn thao tác) then (Đăng ký)
    partition "Đăng ký" {
        :Nhập email, mật khẩu;
        :Hệ thống Validate thông tin;
        if (Hợp lệ?) then (Không)
            :Hiển thị lỗi;
            stop
        else (Có)
            :Tạo tài khoản;
            :Chuyển sang màn hình Đăng nhập;
        endif
    }
else (Đăng nhập)
endif

partition "Đăng nhập" {
    repeat
        :Nhập email và mật khẩu;
        :Kiểm tra thông tin xác thực;
        if (Thông tin đúng?) then (Không)
            :Thông báo lỗi, yêu cầu thử lại;
        else (Có)
            break
        endif
    repeat while (Thử lại?)
    
    :Lưu session người dùng;
    note right: Sử dụng JWT token
    if (Phân quyền người dùng) then (Admin)
        :Gán quyền Admin;
    else (Student)
        :Gán quyền Student;
    endif
    :Chuyển hướng tới Dashboard;
}
stop
@enduml
